{
  "rules": {
    "users": {
      "$uid": {
        ".read":  "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "deals": {
      ".read":  "auth != null && (auth.token.email === 'harut@ymail.com' || root.child('billing').child(auth.uid).child('tier').val() === 'pro' || root.child('users').child(auth.uid).child('data').child('role').val() === 'admin')",
      ".write": false
    },
    "billing": {
      "$uid": {
        ".read":  "$uid === auth.uid",
        ".write": false
      }
    },
    "stripeCustomers": {
      ".read":  false,
      ".write": false
    },
    "rcUsage": {
      ".read":  false,
      ".write": false
    },
    "credits": {
      ".read":  false,
      ".write": false
    },
    "creditsLedger": {
      ".read":  false,
      ".write": false
    },
    "creditSessions": {
      ".read":  false,
      ".write": false
    },
    "reveals": {
      ".read":  false,
      ".write": false
    },
    "skipCache": {
      ".read":  false,
      ".write": false
    },
    "revealUsage": {
      ".read":  false,
      ".write": false
    }
  }
}
